GROQ_KEYS=key1,key2,key3
MONGO_URL=
MONGO_DB_NAME=code_reviewer

# Hackathon/demo default. Set true only when login/session auth is deployed.
AUTH_ENABLED=false
# Internal server-side identity used only while AUTH_ENABLED=false.
DEMO_USER_ID=demo-user

# Auth. JWT_SECRET has NO default -- the server refuses to start without one.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
# Set to false only for local http:// development (cookie needs Secure in production).
COOKIE_SECURE=true
# Comma-separated list of frontend origins allowed to call this API with credentials.
CORS_ORIGINS=http://localhost:5173

# Knowledge retrieval / MongoDB Atlas Vector Search
KNOWLEDGE_COLLECTION=sage_knowledge
KNOWLEDGE_VECTOR_INDEX=sage_knowledge_vector_index

# Embeddings. Required for `python -m knowledge.ingest` and live vector search.
# local_sentence_transformers uses server/services/embeddings.py and all-MiniLM-L6-v2 (384 dimensions).
EMBEDDING_PROVIDER=local_sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
